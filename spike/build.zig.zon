.{
    .name = .zmoshspike,
    .version = "0.1.0",
    .fingerprint = 0xb6bb03d5fe126fd6,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Locally patched audited tree b97b17f06b1ffd694f80edd3df5dd2134a0bcb9e
        // carrying only spike/patches/ghostty-snapshot-reexport.patch.
        // Production zmosh pins the upstream commit containing that re-export.
        .ghostty = .{
            .path = "deps/ghostty",
        },
        // Unmodified upstream spike pin; the PSK gate must pass through
        // public APIs with zero patches.
        .quicz = .{
            .path = "deps/quicz-upstream",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
